{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node", "vite/client", "vite-plugin-pwa/react"]
  },
  "include": ["src", "vite.config.ts", "pwa-assets.config.ts", "playwright.config.ts", "vitest.config.ts", "e2e"],
  "exclude": ["src/sw.ts"]
}
